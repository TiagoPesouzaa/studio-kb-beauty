---
/**
 * Página inicial: só organiza as seções na ordem.
 * O conteúdo vem de src/data e src/config; o visual, de src/components.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/sections/Header.astro";
import Hero from "@/components/sections/Hero.astro";
import Services from "@/components/sections/Services.astro";
import Gallery from "@/components/sections/Gallery.astro";
import About from "@/components/sections/About.astro";
import Testimonials from "@/components/sections/Testimonials.astro";
import Faq from "@/components/sections/Faq.astro";
import Footer from "@/components/sections/Footer.astro";
import WhatsAppFloat from "@/components/sections/WhatsAppFloat.astro";
---

<BaseLayout>
  <Header />
  <main>
    <Hero />
    <Services />
    <Gallery />
    <About />
    <Testimonials />
    <Faq />
  </main>
  <Footer />
  <WhatsAppFloat />
</BaseLayout>
