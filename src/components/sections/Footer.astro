---
import Container from "@/components/ui/Container.astro";
import Button from "@/components/ui/Button.astro";
import { siteConfig } from "@/config/site";
import { creditsLink, instagramLink, whatsappLink } from "@/lib/links";
import { cta, footer } from "@/data/content";

const year = new Date().getFullYear();
---

<footer class="bg-ink pt-20 pb-28 text-white md:pb-12">
  <Container>
    <div class="grid gap-12 md:grid-cols-[1.4fr_1fr]">
      <div>
        <p class="font-display text-4xl leading-tight md:text-5xl">{footer.title}</p>
        <p class="mt-4 max-w-md text-white/70">{siteConfig.region}. {siteConfig.regionNote}</p>
        <Button href={whatsappLink()} whatsapp class="mt-8">{cta.label}</Button>
      </div>

      <dl class="grid gap-6 self-end text-white/80">
        <div>
          <dt class="text-sm text-white/50">WhatsApp</dt>
          <dd><a href={whatsappLink()} target="_blank" rel="noopener noreferrer" class="hover:text-accent">{siteConfig.contact.whatsappDisplay}</a></dd>
        </div>
        <div>
          <dt class="text-sm text-white/50">Instagram</dt>
          <dd><a href={instagramLink()} target="_blank" rel="noopener noreferrer" class="hover:text-accent">@{siteConfig.contact.instagram}</a></dd>
        </div>
      </dl>
    </div>

    <div class="mt-16 flex flex-col gap-2 border-t border-white/10 pt-6 text-sm text-white/50 sm:flex-row sm:justify-between">
      <p>© {year} {siteConfig.name}</p>
      <p>Site por <a href={creditsLink()} target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 hover:text-white">{siteConfig.credits.label}</a></p>
    </div>
  </Container>
</footer>
