---
import Container from "@/components/ui/Container.astro";
import Photo from "@/components/ui/Photo.astro";
import Button from "@/components/ui/Button.astro";
import { instagramLink } from "@/lib/links";
import { about } from "@/data/content";
---

<section id="sobre" aria-labelledby="sobre-titulo" class="py-20 md:py-28">
  <Container class="grid items-center gap-10 md:grid-cols-2 md:gap-16">
    <Photo src={about.image.src} alt={about.image.alt} class="mx-auto max-w-sm" />
    <div>
      <h2 id="sobre-titulo" class="font-display text-4xl leading-tight md:text-5xl">{about.title}</h2>
      {about.paragraphs.map((text) => <p class="mt-5 text-lg text-muted">{text}</p>)}
      <Button href={instagramLink()} variant="outline" icon="instagram" class="mt-8">
        {about.instagramLabel}
      </Button>
    </div>
  </Container>
</section>
