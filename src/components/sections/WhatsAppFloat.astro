---
/** Botão fixo de agendamento, só no celular: fica sempre ao alcance do polegar. */
import { whatsappLink } from "@/lib/links";
import { cta } from "@/data/content";
import WhatsAppIcon from "@/components/ui/WhatsAppIcon.astro";
---

<a
  href={whatsappLink()}
  target="_blank"
  rel="noopener noreferrer"
  class="fixed inset-x-4 bottom-4 z-40 flex min-h-13 items-center justify-center gap-2 rounded-full bg-primary text-base font-medium text-white shadow-lg shadow-primary/25 md:hidden"
>
  <WhatsAppIcon />
  {cta.label}
</a>
