---
import Container from "@/components/ui/Container.astro";
import { siteConfig } from "@/config/site";
import { whatsappLink } from "@/lib/links";
import { cta, navigation } from "@/data/content";
import WhatsAppIcon from "@/components/ui/WhatsAppIcon.astro";

---

<header class="fixed inset-x-0 top-0 z-40 border-b border-surface-strong/70 bg-white/90 backdrop-blur">
  <Container class="flex h-16 items-center justify-between">
    <a href="#inicio" class="font-display text-xl tracking-wide">{siteConfig.shortName}</a>

    <nav aria-label="Seções do site" class="hidden md:block">
      <ul class="flex gap-8 text-base text-muted">
        {navigation.map((link) => (
          <li><a href={link.href} class="transition-colors hover:text-primary">{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <a
      href={whatsappLink()}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex min-h-11 items-center gap-1.5 rounded-full border-2 border-primary px-4 text-sm font-medium text-primary transition-colors hover:bg-primary hover:text-white"
    >
      <WhatsAppIcon class="size-4" />
      {cta.shortLabel}
    </a>
  </Container>
</header>
