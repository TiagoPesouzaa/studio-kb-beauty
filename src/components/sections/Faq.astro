---
import Container from "@/components/ui/Container.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import { faq } from "@/data/content";
---

<section id="duvidas" aria-labelledby="duvidas-titulo" class="bg-blush/50 py-20 md:py-28">
  <Container class="max-w-3xl">
    <SectionHeading id="duvidas-titulo" title="Dúvidas frequentes" />

    <!-- <details> é nativo do HTML: abre e fecha sem JavaScript e já é acessível -->
    <div class="divide-y divide-petal border-y border-petal">
      {faq.map((item) => (
        <details class="group py-5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-medium">
            {item.question}
            <span aria-hidden="true" class="text-2xl leading-none text-berry transition-transform group-open:rotate-45">+</span>
          </summary>
          <p class="mt-3 pr-8 text-mauve">{item.answer}</p>
        </details>
      ))}
    </div>
  </Container>
</section>
