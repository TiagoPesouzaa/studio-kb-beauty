---
import Container from "@/components/ui/Container.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import Photo from "@/components/ui/Photo.astro";
import Button from "@/components/ui/Button.astro";
import { serviceCategories } from "@/data/services";
import { whatsappLinkForService } from "@/lib/links";
import { cta, servicesSection } from "@/data/content";
---

<!--
  Todas as categorias ficam visíveis, uma embaixo da outra (sem abas):
  quem tem menos familiaridade com sites não corre o risco de não ver uma categoria.
  Os atalhos no topo mostram logo de cara tudo o que existe.
-->
<section id="servicos" aria-labelledby="servicos-titulo" class="py-20 md:py-28">
  <Container>
    <SectionHeading id="servicos-titulo" title={servicesSection.title} subtitle={servicesSection.subtitle} />

    <nav aria-label="Categorias de serviço" class="-mt-4 mb-14 flex flex-wrap gap-3">
      {serviceCategories.map((category) => (
        <a
          href={`#${category.id}`}
          class="inline-flex min-h-12 items-center gap-2 rounded-full bg-surface px-6 font-medium text-primary-strong transition-colors hover:bg-surface-strong"
        >
          {category.title}
          <span aria-hidden="true">↓</span>
        </a>
      ))}
    </nav>

    <div class="space-y-20">
      {serviceCategories.map((category) => (
        <div id={category.id} aria-labelledby={`${category.id}-titulo`}>
          <h3
            id={`${category.id}-titulo`}
            class="mb-10 border-b border-surface-strong pb-3 font-display text-3xl font-semibold md:text-4xl"
          >
            {category.title}
          </h3>

          <ul class="grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
            {category.services.map((service) => (
              <li class="flex gap-5 sm:flex-col">
                <div class="w-28 shrink-0 sm:w-full">
                  <Photo src={service.image} alt={service.name} aspect="square" zoomable />
                </div>
                <div class="flex flex-1 flex-col">
                  <h4 class="font-display text-2xl leading-snug font-semibold">
                    {service.name}
                    {service.comingSoon && (
                      <span class="ml-2 align-middle font-sans text-sm font-medium text-primary">Em breve</span>
                    )}
                  </h4>
                  {service.description && <p class="mt-2 text-muted">{service.description}</p>}
                  {!service.comingSoon && (
                    <Button
                      href={whatsappLinkForService(service.name)}
                      variant="outline"
                      whatsapp
                      ariaLabel={`${cta.shortLabel} ${service.name} pelo WhatsApp`}
                      class="mt-4 self-start"
                    >
                      {cta.shortLabel}
                    </Button>
                  )}
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </Container>
</section>
