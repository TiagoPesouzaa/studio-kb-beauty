---
import Container from "@/components/ui/Container.astro";
import Button from "@/components/ui/Button.astro";
import { siteConfig } from "@/config/site";
import { whatsappLink } from "@/lib/links";
import { cta, hero } from "@/data/content";
---

<!--
  Topo do site: texto à esquerda e a foto dela recortada "saindo" de um arco rosa.
  No celular, a foto fica embaixo e sobe um pouco por trás do texto (margem negativa).
-->
<section id="inicio" class="relative overflow-hidden bg-surface pt-16">
  <Container class="grid md:grid-cols-2 md:items-end">
    <div class="relative z-10 pt-10 md:pt-24 md:pb-36">
      <p class="mb-4 text-sm text-muted">{siteConfig.region}</p>

      <h1 class="font-display text-[3.6rem] leading-[0.92] font-semibold sm:text-7xl lg:text-8xl">
        {hero.titleLines.map((line) => <span class="block">{line}</span>)}
      </h1>

      <p class="mt-5 max-w-[15rem] text-muted sm:max-w-sm md:text-lg">{siteConfig.tagline}</p>

      <div class="mt-7 flex flex-wrap gap-3">
        <Button href={whatsappLink()} icon="whatsapp">
          <!-- No celular o texto curto não invade a foto -->
          <span class="md:hidden">{cta.shortLabel}</span>
          <span class="hidden md:inline">{cta.label}</span>
        </Button>
        <!-- No celular o botão fixo de WhatsApp já cumpre esse papel -->
        <div class="hidden md:block">
          <Button href="#servicos" variant="outline">Ver serviços</Button>
        </div>
      </div>
    </div>

    <div class="relative -mx-5 -mt-20 h-[30rem] sm:-mt-6 sm:h-[34rem] md:mx-0 md:mt-0 md:h-[40rem]">
      <!-- Arco atrás da foto -->
      <div
        aria-hidden="true"
        class="absolute right-[-12%] bottom-0 h-[86%] w-[92%] rounded-t-full bg-surface-strong md:right-[-4%] md:w-[88%]"
      >
      </div>
      <img
        src={hero.image.src}
        alt={hero.image.alt}
        width={hero.image.width}
        height={hero.image.height}
        fetchpriority="high"
        decoding="async"
        class="hero-photo absolute right-[-6%] bottom-0 h-full w-auto max-w-none md:right-0"
      />
    </div>
  </Container>
</section>

<style>
  /* Suaviza as laterais onde a foto original termina (o braço e a jaqueta são cortados pela borda) */
  .hero-photo {
    mask-image: linear-gradient(to right, transparent 0, #000 12%, #000 88%, transparent 100%);
  }
</style>
