---
/**
 * Botão-link reutilizável.
 * - variant: "primary" (ação principal) ou "outline" (secundária)
 * - icon: "whatsapp" ou "instagram". Mostra o ícone e abre em nova aba
 * - external: abre em nova aba sem ícone
 * - ariaLabel: texto completo para leitores de tela quando o rótulo visível é curto
 */
import WhatsAppIcon from "@/components/ui/WhatsAppIcon.astro";
import InstagramIcon from "@/components/ui/InstagramIcon.astro";

type Props = {
  href: string;
  variant?: "primary" | "outline";
  icon?: "whatsapp" | "instagram";
  external?: boolean;
  ariaLabel?: string;
  class?: string;
};

const { href, variant = "primary", icon, external = false, ariaLabel, class: className } = Astro.props;

const opensNewTab = external || icon !== undefined;

const variants = {
  primary: "bg-primary text-white hover:bg-primary-strong",
  outline: "border-2 border-primary text-primary hover:bg-surface",
};

const icons = {
  whatsapp: WhatsAppIcon,
  instagram: InstagramIcon,
};
const Icon = icon ? icons[icon] : undefined;
---

<a
  href={href}
  aria-label={ariaLabel}
  class:list={[
    "inline-flex min-h-12 items-center justify-center gap-2 rounded-full px-6 text-base font-medium transition-colors",
    variants[variant],
    className,
  ]}
  {...opensNewTab && { target: "_blank", rel: "noopener noreferrer" }}
>
  {Icon && <Icon />}
  <slot />
</a>
