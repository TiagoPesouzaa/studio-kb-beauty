---
/**
 * Botão-link reutilizável.
 * - variant: "primary" (ação principal) ou "outline" (secundária)
 * - whatsapp: mostra o ícone do WhatsApp e já abre em nova aba
 * - ariaLabel: texto completo para leitores de tela quando o rótulo visível é curto
 */
import WhatsAppIcon from "@/components/ui/WhatsAppIcon.astro";

type Props = {
  href: string;
  variant?: "primary" | "outline";
  external?: boolean;
  whatsapp?: boolean;
  ariaLabel?: string;
  class?: string;
};

const {
  href,
  variant = "primary",
  external = false,
  whatsapp = false,
  ariaLabel,
  class: className,
} = Astro.props;

const opensNewTab = external || whatsapp;

const variants = {
  primary: "bg-primary text-white hover:bg-primary-strong",
  outline: "border-2 border-primary text-primary hover:bg-surface",
};
---

<a
  href={href}
  aria-label={ariaLabel}
  class:list={[
    "inline-flex min-h-12 items-center justify-center gap-2 rounded-full px-6 text-base font-medium transition-colors",
    variants[variant],
    className,
  ]}
  {...opensNewTab && { target: "_blank", rel: "noopener noreferrer" }}
>
  {whatsapp && <WhatsAppIcon />}
  <slot />
</a>
