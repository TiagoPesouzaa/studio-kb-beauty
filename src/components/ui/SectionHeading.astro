---
/** Título padrão das seções, para manter a mesma hierarquia em todo o site. */
type Props = {
  title: string;
  subtitle?: string;
  id?: string;
};

const { title, subtitle, id } = Astro.props;
---

<header class="mb-10 max-w-xl md:mb-14">
  <h2 id={id} class="font-display text-4xl leading-tight md:text-5xl">{title}</h2>
  {subtitle && <p class="mt-3 text-lg text-muted">{subtitle}</p>}
</header>
