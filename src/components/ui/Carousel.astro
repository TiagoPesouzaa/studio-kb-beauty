---
/**
 * Lista que desliza para o lado.
 * No celular a pessoa arrasta com o dedo (CSS scroll-snap, sem biblioteca);
 * no computador aparecem as setas. Cada filho do slot deve ser um <li>.
 */
type Props = {
  label: string;
};

const { label } = Astro.props;
const arrowClass =
  "flex size-11 items-center justify-center rounded-full border border-primary text-lg text-primary transition-colors hover:bg-primary hover:text-white";
---

<div class="carousel relative" data-carousel>
  <ul
    aria-label={label}
    class="carousel-track -mx-5 flex snap-x snap-mandatory gap-3 overflow-x-auto scroll-px-5 px-5 pb-2 md:mx-0 md:scroll-px-0 md:gap-5 md:px-0"
  >
    <slot />
  </ul>

  <div class="mt-6 hidden justify-end gap-2 md:flex">
    <button type="button" data-direction="-1" aria-label="Fotos anteriores" class={arrowClass}>←</button>
    <button type="button" data-direction="1" aria-label="Próximas fotos" class={arrowClass}>→</button>
  </div>
</div>

<style>
  .carousel-track {
    scrollbar-width: none;
  }
  .carousel-track::-webkit-scrollbar {
    display: none;
  }
  .carousel-track > :global(li) {
    flex: 0 0 72%;
    scroll-snap-align: start;
  }
  @media (min-width: 640px) {
    .carousel-track > :global(li) {
      flex-basis: 44%;
    }
  }
  @media (min-width: 768px) {
    .carousel-track > :global(li) {
      flex-basis: calc((100% - 2 * 1.25rem) / 3);
    }
  }
</style>

<script>
  // As setas rolam uma "página" (a largura visível) por clique
  document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((carousel) => {
    const track = carousel.querySelector<HTMLElement>(".carousel-track")!;
    carousel.querySelectorAll<HTMLButtonElement>("[data-direction]").forEach((button) => {
      button.addEventListener("click", () => {
        track.scrollBy({ left: Number(button.dataset.direction) * track.clientWidth, behavior: "smooth" });
      });
    });
  });
</script>
